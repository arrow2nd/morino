{
  "tasks": {
    "start": "deno task build && deno task serve",
    "serve": "deno run --allow-net=:8000 --allow-read --allow-env --watch ./server.js",
    "build": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run ./tools/build.js",
    "fmt": "deno fmt *.js ./libs/*.js ./tools/*.js"
  },
  "imports": {
    "@deno/emit": "jsr:@deno/emit@^0.46.0",
    "@std/crypto": "jsr:@std/crypto@^1.0.5",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "esbuild": "https://deno.land/x/esbuild@v0.19.11/mod.js"
  },
  "lock": false
}
